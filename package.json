{
  "name": "seanbetts",
  "repo": "https://seanbetts.github.io/seanbetts",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "netlify-cli": "^17.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.26.1",
    "react-scripts": "^5.0.1",
    "@phosphor-icons/react": "^2.1.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/prerender.cjs && node scripts/check-crawl.cjs && node scripts/check-images.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "check:crawl": "node scripts/check-crawl.cjs",
    "images:prepare": "node scripts/prepare-images.cjs",
    "prestart": "npm run images:prepare",
    "prebuild": "npm run images:prepare",
    "pretest": "npm run images:prepare",
    "check:images": "node scripts/check-images.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "jsdom": "16.7.0",
    "sharp": "^0.35.4",
    "webpack": "5.94.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.2.0"
  }
}
